# Copie para .env.local (nunca faça commit de .env.local).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) ou a chave "anon" legada. Pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (sb_secret_...) ou "service_role" legada. SOMENTE servidor.
# Usada para gerar links de convite. Na Vercel, cadastre como variável sensível.
SUPABASE_SECRET_KEY=

# URL pública da aplicação (links de convite e redefinição de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Testes de banco (opcional): servidor Postgres >= 15 com permissão de CREATE DATABASE
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# E-mail (Fase 5 — pendente de configuração). Não é necessário agora.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Safra ADM <no-reply@seu-dominio>"
